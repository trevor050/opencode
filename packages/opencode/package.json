    "test:ulm-harness": "bun run script/ulm-harness-run.ts --tier fast",
    "test:ulm-harness:full": "bun run script/ulm-harness-run.ts --tier full",
    "test:ulm-harness:chaos": "bun run script/ulm-harness-run.ts --tier chaos",
    "test:ulm-harness:overnight": "bun run script/ulm-harness-run.ts --tier overnight",
