    "ulm:credential-review": "bun run script/ulm-credential-review.ts",
    "ulm:credential-leak-audit": "bun run script/ulm-operation-artifact-audit.ts",
    "ulm:behavior-watch": "bun run script/ulm-behavior-watch.ts",
    "ulm:behavior-probe": "bun run script/ulm-behavior-probe.ts",
